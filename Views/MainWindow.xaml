<Window x:Class="CsXray.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:CsXray.ViewModels"
        Title="CsXray - 通用代理客户端" Height="680" Width="1020"
        WindowStartupLocation="CenterScreen"
        Background="#F8F9FA" FontFamily="Microsoft YaHei UI">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <!-- Button Style -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Background" Value="#0F9753"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0D8247"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryBtn" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#344054"/>
            <Setter Property="BorderBrush" Value="#D0D5DD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F2F4F7"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Top Controls -->
            <RowDefinition Height="*"/>
            <!-- Server Table -->
            <RowDefinition Height="Auto"/>
            <!-- Splitter -->
            <RowDefinition Height="180"/>
            <!-- Log Console -->
            <RowDefinition Height="Auto"/>
            <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- Top Tool Bar -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#EAECF0" BorderThickness="0,0,0,1" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Proxy Mode Radio Buttons -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton Content="不使用代理" IsChecked="{Binding IsDirectMode}" Margin="0,0,16,0" FontSize="13" VerticalAlignment="Center"/>
                    <RadioButton Content="全局代理" IsChecked="{Binding IsProxyMode}" Margin="0,0,16,0" FontSize="13" VerticalAlignment="Center"/>
                    <RadioButton Content="PAC代理" IsChecked="{Binding IsPacMode}" Margin="0,0,24,0" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Status / Info -->
                <TextBlock Grid.Column="1" Text="{Binding StatusText}" VerticalAlignment="Center" Foreground="#475467" FontSize="13" Margin="10,0"/>

                <!-- Right Action Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="{Binding ToggleServiceButtonText}" Click="BtnToggleService_Click" Margin="0,0,8,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                        <Setter Property="Background" Value="#D92D20"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="检测并连接最快服务器" Style="{StaticResource SecondaryBtn}" Click="BtnFastest_Click" Margin="0,0,8,0"/>
                    <Button Content="批量导入链接" Style="{StaticResource SecondaryBtn}" Click="BtnImport_Click" Margin="0,0,8,0"/>
                    <Button Content="新增节点" Style="{StaticResource SecondaryBtn}" Click="BtnAddNode_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Server Table -->
        <DataGrid Grid.Row="1" x:Name="ServerDataGrid" ItemsSource="{Binding Nodes}" SelectedItem="{Binding SelectedNode}"
                  AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                  SelectionMode="Single" HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EAECF0"
                  Background="#FFFFFF" RowBackground="#FFFFFF" AlternatingRowBackground="#FAFAFA"
                  RowHeight="36" MouseDoubleClick="DataGrid_MouseDoubleClick">
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="设为活动服务器 (鼠标双击)" FontWeight="Bold" Click="MenuSetActive_Click"/>
                    <Separator/>
                    <MenuItem Header="修改节点" Click="MenuEditNode_Click"/>
                    <MenuItem Header="增加节点" Click="MenuAddNode_Click"/>
                    <Separator/>
                    <MenuItem Header="复制服务器分享链接" Click="MenuCopyLink_Click"/>
                    <MenuItem Header="测试此节点延迟" Click="MenuPing_Click"/>
                    <Separator/>
                    <MenuItem Header="上移服务器 (Ctrl+Up)" Click="MenuMoveUp_Click"/>
                    <MenuItem Header="下移服务器 (Ctrl+Down)" Click="MenuMoveDown_Click"/>
                    <MenuItem Header="置顶服务器" Click="MenuMoveTop_Click"/>
                    <MenuItem Header="置底服务器" Click="MenuMoveBottom_Click"/>
                    <Separator/>
                    <MenuItem Header="自剪贴板批量导入分享链接、订阅源" Click="MenuImport_Click"/>
                    <MenuItem Header="按「响应速度」排序服务器" Click="MenuSortBySpeed_Click"/>
                    <Separator/>
                    <MenuItem Header="删除节点" Click="MenuDeleteNode_Click"/>
                    <MenuItem Header="清空服务器列表" Click="MenuClearNodes_Click"/>
                </ContextMenu>
            </DataGrid.ContextMenu>

            <DataGrid.Columns>
                <!-- Is Active Indicator -->
                <DataGridTemplateColumn Header="状态" Width="60">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border CornerRadius="3" Padding="4,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter Property="Background" Value="#D1FADF"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock HorizontalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value=""/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="Text" Value="活动"/>
                                                    <Setter Property="Foreground" Value="#027A48"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="协议" Binding="{Binding Protocol}" Width="90"/>
                <DataGridTextColumn Header="备注 (ps)" Binding="{Binding Ps}" Width="180"/>
                <DataGridTextColumn Header="服务器 (address)" Binding="{Binding Address}" Width="160"/>
                <DataGridTextColumn Header="端口" Binding="{Binding Port}" Width="70"/>
                <DataGridTextColumn Header="加密" Binding="{Binding Security}" Width="110"/>
                <DataGridTextColumn Header="传输" Binding="{Binding Network}" Width="80"/>
                <DataGridTextColumn Header="TLS" Binding="{Binding Tls}" Width="70"/>

                <!-- Delay -->
                <DataGridTemplateColumn Header="响应速度" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DelayText}" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#344054"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DelayText}" Value="超时">
                                                <Setter Property="Foreground" Value="#D92D20"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Grid Splitter -->
        <GridSplitter Grid.Row="2" Height="4" HorizontalAlignment="Stretch" Background="#E4E7EC" Cursor="SizeNS"/>

        <!-- Log Output Console -->
        <Border Grid.Row="3" Background="#1E1E1E">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#252526" Padding="12,6">
                    <Grid>
                        <TextBlock Text="Xray 核心运行日志" Foreground="#CCCCCC" FontSize="12" VerticalAlignment="Center"/>
                        <Button Content="清空日志" HorizontalAlignment="Right" Click="BtnClearLog_Click"
                                Background="Transparent" Foreground="#9CDCFE" BorderThickness="0" Cursor="Hand" FontSize="12"/>
                    </Grid>
                </Border>

                <TextBox Grid.Row="1" x:Name="TxtLog" Text="{Binding LogText, Mode=OneWay}"
                         IsReadOnly="True" Background="#1E1E1E" Foreground="#D4D4D4"
                         FontFamily="Consolas" FontSize="12" BorderThickness="0"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         TextChanged="TxtLog_TextChanged" Margin="8,4"/>
            </Grid>
        </Border>

        <!-- Bottom Status Bar -->
        <Border Grid.Row="4" Background="#FFFFFF" BorderBrush="#EAECF0" BorderThickness="0,1,0,0" Padding="12,6">
            <Grid>
                <TextBlock Text="CsXray 4.0 - 已就绪" Foreground="#667085" FontSize="12"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="服务器节点数: " Foreground="#667085" FontSize="12"/>
                    <TextBlock Text="{Binding Nodes.Count}" Foreground="#101828" FontWeight="SemiBold" FontSize="12"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
