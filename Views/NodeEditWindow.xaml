<Window x:Class="CsXray.Views.NodeEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑 / 新增代理服务器节点" Height="580" Width="550"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F5F6F8" FontFamily="Microsoft YaHei UI">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#333333"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="BorderBrush" Value="#D0D5DD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="#FFFFFF"/>
        </Style>
        <Style x:Key="FormRowGrid" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock x:Name="TxtHeader" Text="代理服务器配置" FontSize="18" FontWeight="Bold" Foreground="#101828" Margin="0,0,0,16"/>

        <!-- Form fields -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Protocol -->
                <Grid Style="{StaticResource FormRowGrid}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="代理协议:"/>
                    <ComboBox x:Name="CmbProtocol" Grid.Column="1" SelectionChanged="CmbProtocol_SelectionChanged">
                        <ComboBoxItem Content="vmess"/>
                        <ComboBoxItem Content="vless"/>
                        <ComboBoxItem Content="trojan"/>
                        <ComboBoxItem Content="shadowsocks"/>
                        <ComboBoxItem Content="hysteria2"/>
                        <ComboBoxItem Content="tuic"/>
                        <ComboBoxItem Content="socks"/>
                        <ComboBoxItem Content="http"/>
                    </ComboBox>
                </Grid>

                <!-- Remarks (PS) -->
                <Grid Style="{StaticResource FormRowGrid}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="节点备注 (ps):"/>
                    <TextBox x:Name="TxtPs" Grid.Column="1"/>
                </Grid>

                <!-- Server Address -->
                <Grid Style="{StaticResource FormRowGrid}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="服务器 (address):"/>
                    <TextBox x:Name="TxtAddress" Grid.Column="1"/>
                </Grid>

                <!-- Port -->
                <Grid Style="{StaticResource FormRowGrid}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="服务端口 (port):"/>
                    <TextBox x:Name="TxtPort" Grid.Column="1"/>
                </Grid>

                <!-- UserId / Password -->
                <Grid Style="{StaticResource FormRowGrid}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="LblUserId" Text="UUID / 密码:"/>
                    <Grid Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtUserId"/>
                        <Button Grid.Column="1" Content="生成" Width="60" Margin="8,0,0,0" Height="32" Click="BtnGenGuid_Click" Background="#EAECF0" BorderBrush="#D0D5DD"/>
                    </Grid>
                </Grid>

                <!-- Transport Network -->
                <Grid Style="{StaticResource FormRowGrid}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="传输协议 (network):"/>
                    <ComboBox x:Name="CmbNetwork" Grid.Column="1">
                        <ComboBoxItem Content="tcp"/>
                        <ComboBoxItem Content="ws"/>
                        <ComboBoxItem Content="grpc"/>
                        <ComboBoxItem Content="httpupgrade"/>
                        <ComboBoxItem Content="splithttp"/>
                        <ComboBoxItem Content="h2"/>
                        <ComboBoxItem Content="kcp"/>
                        <ComboBoxItem Content="quic"/>
                    </ComboBox>
                </Grid>

                <!-- Security / Encryption -->
                <Grid Style="{StaticResource FormRowGrid}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="加密方式:"/>
                    <ComboBox x:Name="CmbSecurity" Grid.Column="1">
                        <ComboBoxItem Content="auto"/>
                        <ComboBoxItem Content="none"/>
                        <ComboBoxItem Content="aes-128-gcm"/>
                        <ComboBoxItem Content="aes-256-gcm"/>
                        <ComboBoxItem Content="chacha20-poly1305"/>
                        <ComboBoxItem Content="chacha20-ietf-poly1305"/>
                    </ComboBox>
                </Grid>

                <!-- TLS Mode -->
                <Grid Style="{StaticResource FormRowGrid}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="TLS 加密:"/>
                    <ComboBox x:Name="CmbTls" Grid.Column="1" SelectionChanged="CmbTls_SelectionChanged">
                        <ComboBoxItem Content="none"/>
                        <ComboBoxItem Content="tls"/>
                        <ComboBoxItem Content="reality"/>
                    </ComboBox>
                </Grid>

                <!-- Host / SNI -->
                <Grid Style="{StaticResource FormRowGrid}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="SNI / 伪装域名:"/>
                    <TextBox x:Name="TxtHost" Grid.Column="1"/>
                </Grid>

                <!-- Path -->
                <Grid Style="{StaticResource FormRowGrid}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="路径 (path / service):"/>
                    <TextBox x:Name="TxtPath" Grid.Column="1"/>
                </Grid>

                <!-- Reality Fields -->
                <StackPanel x:Name="PnlReality" Visibility="Collapsed">
                    <Grid Style="{StaticResource FormRowGrid}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="公钥 (pbk):"/>
                        <TextBox x:Name="TxtPublicKey" Grid.Column="1"/>
                    </Grid>
                    <Grid Style="{StaticResource FormRowGrid}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="ShortId (sid):"/>
                        <TextBox x:Name="TxtShortId" Grid.Column="1"/>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Actions -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="取 消" Width="85" Height="34" Margin="0,0,12,0" Background="#FFFFFF" BorderBrush="#D0D5DD" Click="BtnCancel_Click"/>
            <Button x:Name="BtnSave" Content="保 存" Width="95" Height="34" Background="#027A48" Foreground="#FFFFFF" BorderThickness="0" FontWeight="SemiBold" Click="BtnSave_Click"/>
        </StackPanel>
    </Grid>
</Window>
